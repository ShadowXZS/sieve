# ==============================================================================
# Sieve PPC Search Term Optimization Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local to configure local development or production.

# Application Title
VITE_APP_TITLE=Sieve

# Logging Level: debug | info | warn | error | none
VITE_LOG_LEVEL=info

# Ingestion Limit in Megabytes (default: 600MB processed via chunked worker pipeline)
VITE_MAX_INGEST_MB=600

# Analytical Query Execution Timeout in Milliseconds (default: 5000ms)
VITE_DUCKDB_TIMEOUT_MS=5000

# AWS S3 Direct Client Sync Configuration (Optional for client-side cloud backup)
# NOTE: Zero credentials should be stored in source control.
VITE_S3_REGION=us-east-1
VITE_S3_BUCKET=
VITE_S3_CUSTOM_ENDPOINT=

