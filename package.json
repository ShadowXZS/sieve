{
  "name": "sieve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release --offline -p sieve_core && wasm-bindgen target/wasm32-unknown-unknown/release/sieve_core.wasm --out-dir crates/sieve_core/pkg --target web && cp crates/sieve_core/pkg/sieve_core_bg.wasm Public/sieve_core_bg.wasm",
    "test:rs": "cargo test --offline -p sieve_core",
    "test:wasm": "node --import tsx --test tests/wasm/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:components": "node --import tsx --import ./tests/setup.ts --test tests/components/*.test.tsx",
    "test": "npm run build:wasm && npm run test:rs && node scripts/test-runner.mjs"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-virtual": "^3.14.25",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  }
}
